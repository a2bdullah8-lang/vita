{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with calculated BMR, TDEE, deficit, and weight goals",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "heightCm": { "type": "number" },
        "currentWeightKg": { "type": "number" },
        "targetWeightKg": { "type": "number" },
        "activityLevel": { "type": "string" },
        "weeklyLossPace": { "type": "number" },
        "dietType": { "type": "string" },
        "workoutDaysPerWeek": { "type": "number" },
        "bmr": { "type": "number" },
        "tdee": { "type": "number" },
        "dailyCalorieDeficit": { "type": "number" },
        "dailyCalorieTarget": { "type": "number" },
        "dailyProteinTarget": { "type": "number" },
        "dailyWaterGoalMl": { "type": "number" },
        "dailyStepGoal": { "type": "number" },
        "onboardingCompleted": { "type": "boolean" },
        "themeMode": { "type": "string", "enum": ["light", "dark"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "currentWeightKg", "targetWeightKg"]
    },
    "DailyEntry": {
      "title": "DailyEntry",
      "description": "Daily tracking document stored at users/{uid}/days/{YYYY-MM-DD}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "caloriesConsumed": { "type": "number" },
        "proteinGrams": { "type": "number" },
        "carbsGrams": { "type": "number" },
        "fatGrams": { "type": "number" },
        "meals": { "type": "array" },
        "workouts": { "type": "array" },
        "workoutCaloriesBurned": { "type": "number" },
        "steps": { "type": "number" },
        "stepCaloriesBurned": { "type": "number" },
        "totalCaloriesBurned": { "type": "number" },
        "waterMl": { "type": "number" },
        "weight": { "type": "number" },
        "note": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "date"]
    },
    "UserReminder": {
      "title": "UserReminder",
      "description": "User created reminder schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "time": { "type": "string" },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "time"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile, goals, BMR, and settings"
    },
    "/users/{userId}/days/{dayId}": {
      "schema": "DailyEntry",
      "description": "Daily tracking documents indexed by local date YYYY-MM-DD"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": "UserReminder",
      "description": "User custom reminders for hydration, meals, and workouts"
    }
  }
}
