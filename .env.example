# Gemini AI API Key (Required for AI Craving Crusher Coach)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Firebase Configuration (for multi-device sync and authentication)
# If omitted, VITA automatically uses instant offline-first localStorage persistence.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional: Google Health & Fit API Client ID
VITE_GOOGLE_HEALTH_CLIENT_ID=""
